{
    "name": "kmac420/stock-dependencies-for-woocommerce",
    "description": "Make the products and variations in your WooCommerce store dependent on the inventory of your other products or variations",
    "type": "wordpress-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Kevin McCall",
            "email": "kevin@kef.ca"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=7.2",
        "wp-cli/wp-cli-bundle": "^2.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "yoast/phpunit-polyfills": "^1.0",
        "wp-phpunit/wp-phpunit": "^6.1",
        "mockery/mockery": "^1.5"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "autoload": {
        "psr-4": {
            "StockDependenciesForWooCommerce\\": "wc-stock-dependencies/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StockDependenciesForWooCommerce\\Tests\\": "tests/"
        }
    }
}
